{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Perxona Connect Kit — Presenter Config Schemas",
  "description": "JSON Schema for AvatarConfig, SceneConfig, and Performance — the three types required by sv-presenter.initialize() and sv-presenter.playPerformance().",
  "$defs": {
    "AvatarConfig": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "assetUrls": {
          "$ref": "#/definitions/Record%3CAssetQuality%2Cstring%3E"
        },
        "motions": {
          "$ref": "#/definitions/MotionSet"
        },
        "defaultFacial": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MotionAsset"
          }
        },
        "lipsyncMode": {
          "$ref": "#/definitions/LipSyncMode"
        },
        "lipsyncConfig": {
          "$ref": "#/definitions/Record%3Cstring%2CLipSyncConfig%3E"
        }
      },
      "required": [
        "id",
        "assetUrls",
        "motions",
        "defaultFacial",
        "lipsyncMode",
        "lipsyncConfig"
      ],
      "additionalProperties": false
    },
    "LipSyncConfig": {
      "type": "object",
      "properties": {
        "configUrl": {
          "type": "string"
        },
        "profileUrl": {
          "type": "string"
        }
      },
      "required": [
        "configUrl",
        "profileUrl"
      ],
      "additionalProperties": false
    },
    "LipSyncMode": {
      "type": "string",
      "enum": [
        "xrlipsync",
        "wlipsync"
      ]
    },
    "MotionAsset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/MotionType"
        },
        "assetUrl": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "assetUrl"
      ],
      "additionalProperties": false
    },
    "MotionSet": {
      "$ref": "#/definitions/Record%3CMotionState%2Cdef-alias-159151763-198-284-159151763-0-285%5B%5D%3E"
    },
    "MotionType": {
      "type": "string",
      "enum": [
        "body",
        "face"
      ]
    },
    "Performance": {
      "type": "object",
      "properties": {
        "motions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MotionAsset"
          },
          "description": "All the preemptive motion assets that will be used in this performance. These motions should be preloaded before playing the performance to ensure smooth playback."
        },
        "message": {
          "type": "string",
          "description": "The text content of the performance"
        },
        "ssml": {
          "type": "string",
          "description": "The SSML string for the performance, which will be converted to speech."
        },
        "voiceName": {
          "type": "string",
          "description": "The name of the voice to be used for speech synthesis and switching lip-sync configuration in this performance."
        }
      },
      "required": [
        "motions",
        "message",
        "ssml",
        "voiceName"
      ],
      "additionalProperties": false
    },
    "Record<AssetQuality,string>": {
      "type": "object",
      "properties": {
        "lod0": {
          "type": "string"
        },
        "lod1": {
          "type": "string"
        },
        "lod2": {
          "type": "string"
        }
      },
      "required": [
        "lod0",
        "lod1",
        "lod2"
      ],
      "additionalProperties": false
    },
    "Record<MotionState,def-alias-159151763-198-284-159151763-0-285[]>": {
      "type": "object",
      "properties": {
        "idle": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MotionAsset"
          }
        },
        "talking": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MotionAsset"
          }
        },
        "listening": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MotionAsset"
          }
        },
        "loading": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MotionAsset"
          }
        },
        "error": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MotionAsset"
          }
        }
      },
      "required": [
        "idle",
        "talking",
        "listening",
        "loading",
        "error"
      ],
      "additionalProperties": false
    },
    "Record<string,LipSyncConfig>": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/LipSyncConfig"
      }
    },
    "SceneConfig": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "assetUrls": {
          "$ref": "#/definitions/Record%3CAssetQuality%2Cstring%3E"
        }
      },
      "required": [
        "id",
        "assetUrls"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "title": "AvatarConfig",
      "$ref": "#/$defs/AvatarConfig"
    },
    {
      "title": "SceneConfig",
      "$ref": "#/$defs/SceneConfig"
    },
    {
      "title": "Performance",
      "$ref": "#/$defs/Performance"
    }
  ]
}
