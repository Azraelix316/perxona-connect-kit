# Perxona Connect Kit — Environment Variables
# ─────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values (ask your Perxona contact for API URL + credentials)
# 3. Start the server: npm start

# ── Required ───────────────────────────────────────────────────────────────

# Perxona API base URL — provided by your Perxona contact (region-specific)
# Example: https://console.perxona.ai/eu  or  https://console.perxona.ai/asia
PERXONA_API_BASE_URL=

# Perxona Connect service credentials — the server logs in with these on your
# behalf (no browser sign-in). Ask your Perxona contact for an account. Every
# visitor to this sample shares this one Connect identity.
PERXONA_CONNECT_EMAIL=
PERXONA_CONNECT_PASSWORD=

# ── Optional ───────────────────────────────────────────────────────────────

# Server port (default: 8088)
PORT=8088

# Perxona presenter engine URL (CDN). Defaults to the production engine.
# Override only if your Perxona contact provides a specific URL.
PRESENTER_URL=https://cdn.perxona.ai/prod/latest/widget/entry/presenter.js

# ── LLM chat integration (Option C — disabled by default) ──────────────────
# Leave LLM_API_KEY blank to keep chat disabled (safe default, no key required)
# Fill in to enable the chat panel → avatar answers questions
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Local & free (Ollama): LLM_BASE_URL=http://localhost:11434/v1  (no key needed)
